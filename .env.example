# ---------------------------------------------------------------------------
# x-web environment
# Copy to .env (local) or add the variables in your Vercel project settings.
# ---------------------------------------------------------------------------

# Default provider used when a request does not pin one: tavily | brave | serper | exa
XWEB_SEARCH_PROVIDER=tavily

# Provider keys — set any combination; search blends all configured keys by default.
# A visitor-supplied key is used only with the provider selected for that request.
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=

# Image search defaults to Brave (or set Serper); optionally use a dedicated key.
XWEB_IMAGE_SEARCH_PROVIDER=brave
# XWEB_IMAGE_SEARCH_API_KEY=

# Server-side key used by the playground when the visitor does not paste one.
XWEB_SEARCH_API_KEY=

# Forward to a real x-web deployment instead of calling a provider directly.
# XWEB_API_BASE=https://api.x-web.dev/v1

# Supabase account backend (enable Email + Google providers in Supabase Auth).
# Set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY in Vercel Preview/Production
# for the statically built login UI (same values as URL + public publishable/anon key).
# These two are safe to expose. Server integration names SUPABASE_URL /
# SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY are also recognized at runtime.
# Apply supabase/migrations/202610160001_account_dashboard.sql before enabling accounts.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required to store users' provider keys encrypted at rest (generate a random 32+ byte secret).
XWEB_PROVIDER_KEY_ENCRYPTION_KEY=

# AI synthesis is BYOK-only. Save OpenAI, Anthropic, Groq, OpenRouter, or xKiro credentials in the user dashboard.
# Per-account BYOK settings require migrations 202610170001_ai_credentials.sql and
# 202610170002_add_openrouter_xkiro_ai_providers.sql (for OpenRouter/xKiro support).
# XWEB_ANSWER_TIMEOUT_MS=12000
# XWEB_ANSWER_CONTEXT_CHARS=6000

# Optional extraction and in-memory rate-limit tuning
# XWEB_EXTRACT_MAX_CHARS=12000
# XWEB_RATE_MAX=30
# XWEB_RATE_WINDOW_MS=60000
