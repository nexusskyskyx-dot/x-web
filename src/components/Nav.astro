---
import Icon from './Icons.astro';

const links = [
  { label: 'Docs', href: '/docs' },
  { label: 'API', href: '/docs/api' },
  { label: 'MCP', href: '/docs/mcp' },
  { label: 'Providers', href: '/docs/providers' },
];

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-ink-100 bg-white/85 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2.5" aria-label="x-web home">
      <span
        class="ring-gradient grid h-9 w-9 place-items-center rounded-xl text-white shadow-[0_8px_20px_-8px_rgb(109_40_217/0.95)]"
      >
        <span class="font-mono text-lg leading-none font-bold">x</span>
      </span>
      <span class="text-[17px] font-bold tracking-tight text-ink-900">x-web</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition',
              path.startsWith(link.href)
                ? 'bg-brand-50 text-brand-700'
                : 'text-ink-600 hover:bg-brand-50/60 hover:text-brand-700',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href="https://github.com/nexusskyskyx-dot/x-web"
        target="_blank"
        rel="noreferrer"
        class="btn-ghost btn-sm hidden sm:inline-flex"
      >
        <Icon name="github" class="h-4 w-4" />
        GitHub
      </a>
      <a href="/docs/quickstart" class="btn-primary btn-sm">Get API key</a>
      <button
        type="button"
        class="btn-ghost btn-sm md:hidden"
        aria-label="Toggle navigation"
        aria-expanded="false"
        data-nav-toggle
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <div class="border-t border-ink-100 bg-white md:hidden" data-nav-menu hidden>
    <nav class="mx-auto max-w-7xl space-y-1 px-4 py-4 sm:px-6" aria-label="Mobile">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="block rounded-lg px-3 py-2.5 text-sm font-medium text-ink-700 hover:bg-brand-50 hover:text-brand-700"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://github.com/nexusskyskyx-dot/x-web"
        target="_blank"
        rel="noreferrer"
        class="block rounded-lg px-3 py-2.5 text-sm font-medium text-ink-700 hover:bg-brand-50 hover:text-brand-700"
      >
        GitHub
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.querySelector('[data-nav-menu]');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = !menu.hasAttribute('hidden');
      if (open) {
        menu.setAttribute('hidden', '');
      } else {
        menu.removeAttribute('hidden');
      }
      toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  }
</script>
