---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icons.astro';
import CodeTabs from '../components/CodeTabs.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Playground from '../components/Playground.astro';

const heroTabs = [
  {
    label: 'cURL',
    lang: 'bash',
    code: `curl -X POST https://api.x-web.dev/v1/search \\
  -H "Authorization: Bearer $XWEB_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "query": "What is the Model Context Protocol?",
    "max_results": 5,
    "include_answer": true
  }'`,
  },
  {
    label: 'Python',
    lang: 'python',
    code: `from x_web import XWeb

client = XWeb(api_key=os.environ["XWEB_API_KEY"])

result = client.search(
    "What is the Model Context Protocol?",
    max_results=5,
    include_answer=True,
)

print(result.answer)
for hit in result.results:
    print(hit.title, "->", hit.url)`,
  },
  {
    label: 'Node',
    lang: 'javascript',
    code: `import { XWeb } from "x-web";

const client = new XWeb({ apiKey: process.env.XWEB_API_KEY });

const result = await client.search("What is the Model Context Protocol?", {
  maxResults: 5,
  includeAnswer: true,
});

console.log(result.answer);
result.results.forEach((hit) => console.log(hit.title, "->", hit.url));`,
  },
];

const capabilities = [
  {
    icon: 'search' as const,
    title: 'Search',
    body: 'One endpoint, four independent indexes. Answers with citations, ranked snippets, and raw page text when you need it.',
    accent: 'from-brand-500 to-brand-700',
  },
  {
    icon: 'scrape' as const,
    title: 'Scrape',
    body: 'Turn any URL into clean markdown, HTML or plain text — navigation stripped, boilerplate removed, ready to drop into a context window.',
    accent: 'from-brand-400 to-brand-600',
  },
  {
    icon: 'extract' as const,
    title: 'Extract',
    body: 'Give it a JSON Schema and get structured objects back. Prices, specs, article metadata — parsed, not scraped.',
    accent: 'from-brand-600 to-brand-800',
  },
  {
    icon: 'crawl' as const,
    title: 'Crawl',
    body: 'Follow links with depth and path rules. Walk a docs site or a whole section without writing a scraper.',
    accent: 'from-brand-300 to-brand-500',
  },
];

const features = [
  {
    icon: 'layers' as const,
    title: 'One response shape',
    body: 'Every provider is normalised into the same JSON. Swap Tavily for Brave without touching your agent code.',
  },
  {
    icon: 'shield' as const,
    title: 'Keys stay server-side',
    body: 'Your provider key never has to live in a browser or a prompt. x-web holds it, rotates it and scopes it.',
  },
  {
    icon: 'bolt' as const,
    title: 'Fast by default',
    body: 'Parallel provider fan-out, cached repeats and streaming responses keep tool calls inside your latency budget.',
  },
  {
    icon: 'plug' as const,
    title: 'MCP native',
    body: 'Run x-web as a Model Context Protocol server and every MCP-aware agent gets web access with no glue code.',
  },
];

const steps = [
  {
    title: 'Create a key',
    body: 'Sign up and get an x-web key. Use our pooled credits or bring your own provider key.',
  },
  {
    title: 'Point your agent at it',
    body: 'Call the REST API, install the SDK, or register the MCP server in your favourite client.',
  },
  {
    title: 'Let the agent read the web',
    body: 'Search, scrape, extract and cite — with the same two or three lines of code every time.',
  },
];

const faqs = [
  {
    q: 'Do I need my own search provider key?',
    a: 'No. x-web routes every request across Tavily, Brave, Serper and Exa using pooled credits. If you would rather stay on your own account, add your provider key and x-web will use it exclusively.',
  },
  {
    q: 'Which engine answers my query?',
    a: 'x-web fans out to the providers that fit the request — topic, freshness, language and country — and returns one merged, ranked answer. The response always tells you which provider answered.',
  },
  {
    q: 'Can my agent scrape a page it found?',
    a: 'Yes. Every search result URL can be handed to the scrape endpoint to get clean markdown, and then to the extract endpoint to pull structured fields out of it.',
  },
  {
    q: 'Which clients can use the MCP server?',
    a: 'Anything that speaks the Model Context Protocol — Claude Desktop, Claude Code, Cursor, Windsurf, Zed and your own agents. The server ships as a single command.',
  },
];

const integrations = [
  'OpenAI',
  'Anthropic',
  'LangChain',
  'LlamaIndex',
  'CrewAI',
  'AutoGen',
  'Vercel AI SDK',
  'MCP clients',
];
---

<Base
  title="x-web — Give your AI access to the web"
  description="x-web is one API for web search, scraping, extraction and crawling. Drop it into any AI agent and give it live, cited access to the web."
>
  <!-- ============================= HERO ============================= -->
  <section class="relative overflow-hidden">
    <div class="grid-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -top-40 left-1/2 h-[420px] w-[820px] -translate-x-1/2 rounded-full bg-brand-200/40 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-7xl px-4 pt-16 pb-20 sm:px-6 sm:pt-24 lg:px-8 lg:pt-28">
      <div class="grid items-center gap-14 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]">
        <div class="min-w-0">
          <span class="chip">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
            MCP server included
          </span>

          <h1
            class="mt-6 text-4xl leading-[1.05] font-bold tracking-tight text-ink-900 sm:text-5xl lg:text-6xl"
          >
            Give your AI
            <span class="ring-gradient bg-clip-text text-transparent">access to the web.</span>
          </h1>

          <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600">
            x-web is a single API for search, scraping, extraction and crawling. Your agent stops
            guessing what happened yesterday and starts reading the live web — with citations.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="/docs/quickstart" class="btn-primary">
              Get an API key
              <Icon name="arrowRight" class="h-4 w-4" />
            </a>
            <a href="/docs" class="btn-secondary">Read the docs</a>
          </div>

          <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2.5">
            {
              [
                'Free tier, no card',
                '4 search providers',
                'Citations in every result',
                'Cancel anytime',
              ].map((item) => (
                <li class="flex items-center gap-2 text-sm text-ink-500">
                  <span class="grid h-5 w-5 place-items-center rounded-full bg-brand-50 text-brand-600">
                    <Icon name="check" class="h-3 w-3" />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="relative min-w-0">
          <div
            class="absolute -inset-3 rounded-[28px] bg-gradient-to-br from-brand-200/60 via-brand-100/20 to-transparent blur-2xl"
            aria-hidden="true"
          >
          </div>
          <div class="relative">
            <CodeTabs tabs={heroTabs} />
            <div class="mt-4 rounded-2xl border border-ink-100 bg-white p-4 shadow-card">
              <div class="flex items-center justify-between">
                <p class="text-[11px] font-semibold tracking-wider text-ink-400 uppercase">
                  Response
                </p>
                <span class="font-mono text-[11px] text-ink-400">412ms · tavily</span>
              </div>
              <div class="mt-3">
                <CodeBlock
                  lang="json"
                  title="response.json"
                  code={`{
  "answer": "The Model Context Protocol is an open protocol…",
  "results": [
    {
      "title": "Model Context Protocol",
      "url": "https://modelcontextprotocol.io",
      "score": 0.98
    }
  ],
  "took_ms": 412
}`}
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================= INTEGRATIONS ============================= -->
  <section class="border-y border-ink-100 bg-ink-50/50">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <p class="text-center text-xs font-semibold tracking-wider text-ink-400 uppercase">
        Drop into the stack you already run
      </p>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-3">
        {
          integrations.map((name) => (
            <li class="rounded-full border border-ink-200 bg-white px-4 py-1.5 text-sm font-medium text-ink-600">
              {name}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============================= CAPABILITIES ============================= -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold text-brand-600">Capabilities</p>
      <h2 class="mt-2 text-3xl sm:text-4xl">One API for every corner of the web</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-600">
        Search finds the page. Scrape reads it. Extract structures it. Crawl maps it. Every step
        returns the same predictable JSON your agent already knows how to parse.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        capabilities.map((item) => (
          <article class="card card-hover group p-6">
            <span
              class:list={[
                'grid h-11 w-11 place-items-center rounded-xl bg-gradient-to-br text-white shadow-[0_10px_24px_-12px_rgb(109_40_217/0.9)]',
                item.accent,
              ]}
            >
              <Icon name={item.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-5 text-lg">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============================= FEATURES ============================= -->
  <section class="border-y border-ink-100 bg-gradient-to-b from-brand-50/60 to-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
        <div>
          <p class="text-sm font-semibold text-brand-600">Why x-web</p>
          <h2 class="mt-2 text-3xl sm:text-4xl">Built for agents, not dashboards</h2>
          <p class="mt-4 text-lg leading-relaxed text-ink-600">
            Most search APIs were designed for humans clicking through ten blue links. x-web was
            designed for a model deciding what to read next.
          </p>
          <a href="/docs" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800">
            See the API reference
            <Icon name="arrowRight" class="h-4 w-4" />
          </a>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          {
            features.map((feature) => (
              <div class="rounded-2xl border border-white bg-white/80 p-6 shadow-[0_1px_2px_rgb(26_23_46/0.04)] backdrop-blur">
                <span class="grid h-10 w-10 place-items-center rounded-lg bg-brand-50 text-brand-600">
                  <Icon name={feature.icon} class="h-5 w-5" />
                </span>
                <h3 class="mt-4 text-base">{feature.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-600">{feature.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============================= HOW IT WORKS ============================= -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold text-brand-600">How it works</p>
      <h2 class="mt-2 text-3xl sm:text-4xl">Live in three steps</h2>
    </div>

    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="relative rounded-2xl border border-ink-100 bg-white p-6 shadow-card">
            <span class="ring-gradient grid h-9 w-9 place-items-center rounded-lg text-sm font-bold text-white">
              {index + 1}
            </span>
            <h3 class="mt-4 text-lg">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <div class="min-w-0">
        <h3 class="text-xl">Answer with citations</h3>
        <p class="mt-2 text-ink-600">
          Every result carries the URL it came from, so the model can cite the source and you can
          check the claim.
        </p>
        <div class="mt-5">
          <CodeBlock
            lang="json"
            title="response.json"
            code={`{
  "id": "xweb_9f3c1a20",
  "query": "Model Context Protocol",
  "provider": "tavily",
  "answer": "The Model Context Protocol is an open protocol…",
  "results": [
    {
      "title": "Model Context Protocol",
      "url": "https://modelcontextprotocol.io",
      "snippet": "An open protocol for connecting AI assistants…",
      "score": 0.98
    }
  ],
  "took_ms": 412
}`}
          />
        </div>
      </div>

      <div class="min-w-0">
        <h3 class="text-xl">Wire it into an agent in minutes</h3>
        <p class="mt-2 text-ink-600">
          Register the MCP server once and every tool-aware client can search the web.
        </p>
        <div class="mt-5">
          <CodeBlock
            lang="json"
            title="mcp.json"
            code={`{
  "mcpServers": {
    "x-web": {
      "command": "npx",
      "args": ["-y", "x-web-mcp"],
      "env": { "XWEB_API_KEY": "$XWEB_API_KEY" }
    }
  }
}`}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================= PLAYGROUND ============================= -->
  <section class="border-y border-ink-100 bg-ink-50/60">
    <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold text-brand-600">Try it</p>
        <h2 class="mt-2 text-3xl sm:text-4xl">Run a real search, right here</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-600">
          Bring a Tavily, Brave, Serper or Exa key and this hits the live web — the same code path
          your agent will use.
        </p>
      </div>

      <div class="mt-10">
        <Playground id="home-playground" />
      </div>
    </div>
  </section>

  <!-- ============================= PRICING ============================= -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold text-brand-600">Pricing</p>
      <h2 class="mt-2 text-3xl sm:text-4xl">Start free, scale when it works</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-600">
        Every plan includes all four providers, the full API and the MCP server.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        [
          {
            name: 'Free',
            price: '$0',
            cadence: 'forever',
            description: 'For side projects and evaluation.',
            features: ['1,000 searches / month', 'All four providers', 'MCP server', 'Community support'],
            cta: 'Start free',
            highlight: false,
          },
          {
            name: 'Pro',
            price: '$29',
            cadence: 'per month',
            description: 'For agents running in production.',
            features: [
              '100,000 searches / month',
              'Raw content + extraction',
              'Priority provider routing',
              'Bring your own provider key',
              'Email support',
            ],
            cta: 'Start 14-day trial',
            highlight: true,
          },
          {
            name: 'Team',
            price: 'Custom',
            cadence: 'per seat',
            description: 'For companies shipping AI products.',
            features: [
              'Everything in Pro',
              'SSO and audit logs',
              'Self-hosted or VPC deploy',
              '99.9% uptime SLA',
              'Dedicated support',
            ],
            cta: 'Talk to us',
            highlight: false,
          },
        ].map((plan) => (
          <div
            class:list={[
              'relative flex flex-col rounded-2xl border bg-white p-7',
              plan.highlight
                ? 'border-brand-300 shadow-glow ring-1 ring-brand-200'
                : 'border-ink-100 shadow-card',
            ]}
          >
            {plan.highlight && (
              <span class="ring-gradient absolute -top-3 left-7 rounded-full px-3 py-1 text-[11px] font-bold tracking-wide text-white uppercase">
                Most popular
              </span>
            )}
            <h3 class="text-lg">{plan.name}</h3>
            <p class="mt-1 text-sm text-ink-500">{plan.description}</p>
            <p class="mt-5 flex items-baseline gap-1.5">
              <span class="text-4xl font-bold tracking-tight text-ink-900">{plan.price}</span>
              <span class="text-sm text-ink-500">{plan.cadence}</span>
            </p>
            <ul class="mt-6 flex-1 space-y-2.5">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-sm text-ink-600">
                  <span class="mt-0.5 grid h-4.5 w-4.5 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600">
                    <Icon name="check" class="h-3 w-3" />
                  </span>
                  {feature}
                </li>
              ))}
            </ul>
            <a
              href="/docs/quickstart"
              class:list={['mt-7 w-full', plan.highlight ? 'btn-primary' : 'btn-secondary']}
            >
              {plan.cta}
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============================= FAQ ============================= -->
  <section class="border-t border-ink-100 bg-ink-50/50">
    <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
      <h2 class="text-center text-3xl sm:text-4xl">Questions, answered</h2>
      <div class="mt-10 divide-y divide-ink-100 overflow-hidden rounded-2xl border border-ink-100 bg-white">
        {
          faqs.map((faq) => (
            <details class="group p-6">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-ink-900">
                {faq.q}
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600 transition-transform group-open:rotate-180">
                  <Icon name="chevronDown" class="h-4 w-4" />
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ink-600">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================= CTA ============================= -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-ink-950 px-6 py-12 text-center sm:px-8 sm:py-16">
      <div
        class="pointer-events-none absolute -top-24 left-1/2 h-72 w-[560px] -translate-x-1/2 rounded-full bg-brand-600/30 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative">
        <h2 class="text-3xl text-white sm:text-4xl">Give your agent the whole web</h2>
        <p class="mx-auto mt-4 max-w-xl text-lg text-ink-300">
          One API key, one endpoint, and an AI that knows what happened today.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="/docs/quickstart" class="btn-primary">
            Get an API key
            <Icon name="arrowRight" class="h-4 w-4" />
          </a>
          <a
            href="https://github.com/nexusskyskyx-dot/x-web"
            target="_blank"
            rel="noreferrer"
            class="btn-secondary border-white/15 bg-white/5 text-white hover:border-white/30 hover:bg-white/10"
          >
            <Icon name="github" class="h-4 w-4" />
            View on GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
