---
import Docs from '../../layouts/Docs.astro';
import CodeTabs from '../../components/CodeTabs.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Callout from '../../components/Callout.astro';
import Icon from '../../components/Icons.astro';

const toc = [
  { id: 'what-is-mcp', text: 'What is the MCP server?' },
  { id: 'install', text: 'Install' },
  { id: 'configure', text: 'Configure your client' },
  { id: 'tools', text: 'Available tools' },
  { id: 'remote', text: 'Remote (HTTP) server' },
  { id: 'tips', text: 'Tips' },
];

const clientConfigs = [
  {
    label: 'Claude Desktop',
    lang: 'json',
    code: `{
  "mcpServers": {
    "x-web": {
      "command": "npx",
      "args": ["-y", "x-web-mcp"],
      "env": {
        "XWEB_API_KEY": "xw_live_8f2c41ab…"
      }
    }
  }
}`,
  },
  {
    label: 'Claude Code',
    lang: 'bash',
    code: `claude mcp add x-web --env XWEB_API_KEY=xw_live_8f2c41ab… -- npx -y x-web-mcp`,
  },
  {
    label: 'Cursor',
    lang: 'json',
    code: `{
  "mcpServers": {
    "x-web": {
      "command": "npx",
      "args": ["-y", "x-web-mcp"],
      "env": {
        "XWEB_API_KEY": "xw_live_8f2c41ab…"
      }
    }
  }
}`,
  },
  {
    label: 'Codex / Any client',
    lang: 'json',
    code: `{
  "mcpServers": {
    "x-web": {
      "url": "https://mcp.x-web.dev/mcp",
      "headers": {
        "Authorization": "Bearer xw_live_8f2c41ab…"
      }
    }
  }
}`,
  },
];
---

<Docs
  title="MCP server"
  description="Run x-web as a Model Context Protocol server and every MCP-aware agent gets live web access with no glue code."
  toc={toc}
  updated="October 2026"
>
  <h2 id="what-is-mcp">What is the MCP server?</h2>
  <p>
    The Model Context Protocol is how agents discover and call tools. The x-web MCP server exposes
    search, scrape, extract and crawl as standard MCP tools, so a client like Claude Desktop, Claude
    Code, Cursor, Windsurf or Zed can use the web the moment you add one config block.
  </p>
  <p>
    The server is a thin, well-behaved client for the x-web API: it handles the key, normalises
    responses, and stays out of the way.
  </p>

  <h2 id="install">Install</h2>
  <p>The server ships as a single npm package that runs over stdio.</p>
  <CodeBlock lang="bash" title="terminal" code={`npx -y x-web-mcp --help`} />

  <Callout type="note" title="No global install needed">
    <code>npx -y x-web-mcp</code> downloads and runs the latest version. Pin a version with
    <code>npx -y x-web-mcp@0.4.2</code> if you want reproducible setups.
  </Callout>

  <h2 id="configure">Configure your client</h2>
  <p>
    Add the server to your client's MCP configuration. The only required value is
    <code>XWEB_API_KEY</code>.
  </p>
  <CodeTabs tabs={clientConfigs} />

  <p>
    Restart the client afterwards. A tool list containing <code>x_web_search</code> and
    <code>x_web_scrape</code> means the connection worked.
  </p>

  <h2 id="tools">Available tools</h2>
  <div class="not-prose my-6 grid gap-4 sm:grid-cols-2">
    {
      [
        {
          name: 'x_web_search',
          icon: 'search' as const,
          description: 'Search the web. Returns an answer plus ranked results with URLs.',
        },
        {
          name: 'x_web_scrape',
          icon: 'scrape' as const,
          description: 'Fetch a URL and return clean markdown, text or HTML.',
        },
        {
          name: 'x_web_extract',
          icon: 'extract' as const,
          description: 'Pull structured fields out of one or more pages using a schema.',
        },
        {
          name: 'x_web_crawl',
          icon: 'crawl' as const,
          description: 'Walk a site from a seed URL under depth and path rules.',
        },
      ].map((tool) => (
        <div class="rounded-2xl border border-ink-100 bg-white p-5 shadow-card">
          <div class="flex items-center gap-2.5">
            <span class="grid h-9 w-9 place-items-center rounded-lg bg-brand-50 text-brand-600">
              <Icon name={tool.icon} class="h-4.5 w-4.5" />
            </span>
            <code class="font-mono text-[13px] font-semibold text-brand-800">{tool.name}</code>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-ink-600">{tool.description}</p>
        </div>
      ))
    }
  </div>

  <h3>Tool parameters</h3>
  <CodeBlock
    lang="json"
    title="x_web_search input"
    code={`{
  "query": "string, required",
  "max_results": "integer, optional, default 5",
  "include_answer": "boolean, optional, default true",
  "include_raw_content": "boolean, optional, default false",
  "include_domains": "string[], optional",
  "exclude_domains": "string[], optional",
  "topic": "'general' | 'news', optional",
  "country": "string, optional"
}`}
  />

  <h2 id="remote">Remote (HTTP) server</h2>
  <p>
    Prefer not to run a local process? The hosted server speaks streamable HTTP and works with any
    remote MCP client.
  </p>
  <CodeBlock
    lang="bash"
    title="terminal"
    code={`curl -N https://mcp.x-web.dev/mcp \\
  -H "Authorization: Bearer $XWEB_API_KEY" \\
  -H "Content-Type: application/json" \\
  -H "Accept: application/json, text/event-stream" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/list"
  }'`}
  />

  <h2 id="tips">Tips</h2>
  <ul>
    <li>
      <strong>Let it search first.</strong> Asking the model to check the web before answering is
      worth more than any prompt tweak.
    </li>
    <li>
      <strong>Scraping beats searching</strong> when the model already knows the URL. It is cheaper
      and the content is complete.
    </li>
    <li>
      <strong>Pin the provider</strong> in the environment with
      <code>XWEB_PROVIDER=brave</code> when you need reproducible results for a test suite.
    </li>
    <li>
      <strong>Watch the credit meter.</strong> The server reports usage after every call; read it
      with <code>GET /v1/usage</code>.
    </li>
  </ul>

  <Callout type="tip" title="Building your own MCP server?">
    The x-web API is plain REST with an OpenAPI-compatible description, so any MCP framework can
    wrap it in a few dozen lines.
  </Callout>
</Docs>
