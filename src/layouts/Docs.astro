---
import Base from './Base.astro';
import Icon from '../components/Icons.astro';

export interface TocItem {
  id: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  toc?: TocItem[];
  updated?: string;
}

const { title, description, eyebrow = 'Documentation', toc = [], updated } = Astro.props;

const nav = [
  {
    group: 'Get started',
    items: [
      { label: 'Introduction', href: '/docs' },
      { label: 'Quickstart', href: '/docs/quickstart' },
    ],
  },
  {
    group: 'Core API',
    items: [
      { label: 'API reference', href: '/docs/api' },
      { label: 'Search providers', href: '/docs/providers' },
    ],
  },
  {
    group: 'Integrations',
    items: [
      { label: 'MCP server', href: '/docs/mcp' },
      { label: 'Live playground', href: '/docs/api#playground' },
    ],
  },
];

const path = Astro.url.pathname;

const isActive = (href: string) =>
  href === '/docs' ? path === '/docs' || path === '/docs/' : path.startsWith(href);

const allItems = nav.flatMap((section) => section.items);
const current = allItems.find((item) => isActive(item.href)) ?? allItems[0];
---

<Base title={`${title} · x-web docs`} description={description}>
  <div class="relative isolate overflow-hidden bg-gradient-to-b from-brand-50/50 via-white to-white">
    <div aria-hidden="true" class="pointer-events-none absolute -top-40 right-[-9rem] h-[28rem] w-[28rem] rounded-full border-[5rem] border-brand-100/60"></div>
    <div class="relative mx-auto grid max-w-7xl gap-7 px-4 py-7 sm:px-6 lg:grid-cols-[230px_minmax(0,1fr)] lg:gap-10 lg:px-8 lg:py-10">
    <aside
      class="hidden lg:sticky lg:top-24 lg:block lg:h-[calc(100vh-8rem)] lg:overflow-y-auto lg:rounded-2xl lg:border lg:border-ink-100 lg:bg-white/85 lg:p-4 lg:shadow-card"
    >
      <p class="mb-4 px-3 text-xs font-semibold tracking-wider text-ink-400 uppercase">{eyebrow}</p>
      <nav class="space-y-6" aria-label="Documentation">
        {
          nav.map((section) => (
            <div>
              <p class="mb-2 px-3 text-[11px] font-semibold tracking-wider text-ink-400 uppercase">
                {section.group}
              </p>
              <ul class="space-y-0.5">
                {section.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? 'page' : undefined}
                      class:list={[
                        'block rounded-lg px-3 py-1.5 text-sm transition',
                        isActive(item.href)
                          ? 'bg-brand-50 font-semibold text-brand-700'
                          : 'text-ink-600 hover:bg-brand-50/60 hover:text-brand-700',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <div class="mt-8 rounded-xl border border-brand-200 bg-brand-50/70 p-4">
        <p class="flex items-center gap-2 text-sm font-semibold text-brand-900">
          <Icon name="rocket" class="h-4 w-4 text-brand-600" />
          Try it live
        </p>
        <p class="mt-1.5 text-xs leading-relaxed text-ink-600">
          Run a real web search against Tavily, Brave, Serper or Exa.
        </p>
        <a
          href="/docs/api#playground"
          class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-brand-700 hover:text-brand-800"
        >
          Open the playground
          <Icon name="arrowRight" class="h-3.5 w-3.5" />
        </a>
      </div>
    </aside>

    <div class="min-w-0">
      <!-- mobile / tablet: compact doc switcher instead of the full sidebar -->
      <details class="group mb-6 lg:hidden" data-docs-nav>
        <summary
          class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-xl border border-ink-200 bg-white px-4 py-3 text-sm font-semibold text-ink-900 shadow-card"
        >
          <span class="flex min-w-0 items-center gap-2">
            <Icon name="book" class="h-4 w-4 shrink-0 text-brand-600" />
            <span class="truncate">{current.label}</span>
          </span>
          <Icon
            name="chevronDown"
            class="h-4 w-4 shrink-0 text-ink-400 transition-transform group-open:rotate-180"
          />
        </summary>
        <nav
          class="mt-2 rounded-xl border border-ink-100 bg-white p-2 shadow-card"
          aria-label="Documentation"
        >
          {
            nav.map((section) => (
              <div class="px-2 pt-3 pb-1 first:pt-1">
                <p class="text-[11px] font-semibold tracking-wider text-ink-400 uppercase">
                  {section.group}
                </p>
                <ul class="mt-1 space-y-0.5">
                  {section.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        aria-current={isActive(item.href) ? 'page' : undefined}
                        class:list={[
                          'block rounded-lg px-3 py-2.5 text-[15px] transition',
                          isActive(item.href)
                            ? 'bg-brand-50 font-semibold text-brand-700'
                            : 'text-ink-700 hover:bg-brand-50 hover:text-brand-700',
                        ]}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>

      <header class="relative isolate mb-8 overflow-hidden rounded-3xl border border-brand-100 bg-gradient-to-br from-white via-brand-50/70 to-white p-5 shadow-card sm:mb-10 sm:p-8">
        <div aria-hidden="true" class="pointer-events-none absolute -right-10 -top-16 -z-10 h-48 w-48 rounded-full border-[2rem] border-brand-100/70"></div>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.15em] text-brand-700 uppercase"><span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>{eyebrow}</p>
          {updated && <span class="rounded-full border border-brand-100 bg-white/80 px-3 py-1 text-[11px] font-medium text-ink-500">Updated {updated}</span>}
        </div>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{title}</h1>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-600 sm:text-lg">{description}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="rounded-full border border-brand-100 bg-white/80 px-3 py-1 text-[11px] font-semibold text-brand-700">Live web data</span>
          <span class="rounded-full border border-brand-100 bg-white/80 px-3 py-1 text-[11px] font-semibold text-brand-700">BYOK</span>
          <span class="rounded-full border border-brand-100 bg-white/80 px-3 py-1 text-[11px] font-semibold text-brand-700">Automatic · Standard · Deep</span>
        </div>
      </header>

      <!-- mobile / tablet: the on-page TOC is otherwise unreachable below xl -->
      {
        toc.length > 0 && (
          <details class="group mb-8 rounded-xl border border-ink-100 bg-white xl:hidden" data-docs-toc>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-ink-900">
              On this page
              <Icon
                name="chevronDown"
                class="h-4 w-4 shrink-0 text-ink-400 transition-transform group-open:rotate-180"
              />
            </summary>
            <ul class="space-y-1 border-t border-ink-100 px-4 py-3 text-sm">
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} class="block py-1.5 text-ink-600 transition-colors hover:text-brand-700">
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      <div class="grid gap-10 xl:grid-cols-[minmax(0,1fr)_210px]">
        <article class="prose-docs min-w-0">
          <slot />
        </article>

        {
          toc.length > 0 && (
            <aside class="hidden xl:block">
              <div class="sticky top-24">
                <p class="mb-3 text-xs font-semibold tracking-wider text-ink-400 uppercase">
                  On this page
                </p>
                <ul class="space-y-2 border-l border-ink-100 pl-4 text-sm">
                  {toc.map((item) => (
                    <li>
                      <a href={`#${item.id}`} class="text-ink-500 transition-colors hover:text-brand-700">
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>
          )
        }
      </div>
    </div>
    </div>
  </div>
</Base>

<script>
  // Collapse the mobile nav / TOC disclosures after tapping a link inside them.
  // Cross-page links reload anyway; in-page hash links do not.
  document.querySelectorAll<HTMLDetailsElement>('[data-docs-nav], [data-docs-toc]').forEach((box) => {
    box.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        box.open = false;
      });
    });
  });
</script>
